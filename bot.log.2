 fight I wouldn't lose to anyone.", 'theme_color': None, 'rate_limit_per_user': 0, 'position': 5, 'permission_overwrites': [{'type': 1, 'id': '451379187031343104', 'deny': '550561328145', 'allow': '0'}, {'type': 0, 'id': '1019384647026757695', 'deny': '377959221312', 'allow': '0'}, {'type': 1, 'id': '302050872383242240', 'deny': '0', 'allow': '3073'}, {'type': 0, 'id': '1019369324017881148', 'deny': '0', 'allow': '1024'}, {'type': 0, 'id': '1019369324017881150', 'deny': '70920647479296', 'allow': '0'}], 'parent_id': '1019369324470874221', 'nsfw': False, 'name': '💬・toilet', 'last_pin_timestamp': '2025-07-29T08:47:13.448000+00:00', 'last_message_id': '1407119508497371137', 'id': '1019369324617678848', 'icon_emoji': {'name': '🚽', 'id': None}, 'flags': 0, 'default_thread_rate_limit_per_user': 0}, {'version': 1755397847297, 'type': 0, 'topic': None, 'theme_color': None, 'rate_limit_per_user': 0, 'position': 11, 'permission_overwrites': [{'type': 0, 'id': '1019384647026757695', 'deny': '377959221312', 'allow': '0'}, {'type': 0, 'id': '1019369324017881148', 'deny': '0', 'allow': '1024'}], 'parent_id': '1019369324470874221', 'nsfw': True, 'name': '💩・random-shit', 'last_pin_timestamp': '2025-03-12T23:27:42+00:00', 'last_message_id': '1404760754489659553', 'id': '1019383436160540682', 'icon_emoji': {'name': '💩', 'id': None}, 'flags': 0, 'default_thread_rate_limit_per_user': 0}, {'version': 1755397846945, 'type': 0, 'topic': None, 'theme_color': None, 'rate_limit_per_user': 0, 'position': 6, 'permission_overwrites': [{'type': 1, 'id': '451379187031343104', 'deny': '550561328145', 'allow': '0'}, {'type': 0, 'id': '1019384647026757695', 'deny': '377959221312', 'allow': '0'}, {'type': 1, 'id': '302050872383242240', 'deny': '0', 'allow': '3073'}, {'type': 0, 'id': '1019369324017881148', 'deny': '0', 'allow': '1024'}, {'type': 0, 'id': '1019369324017881150', 'deny': '70920647479296', 'allow': '0'}], 'parent_id': '1019369324470874221', 'nsfw': False, 'name': '💬・links', 'last_message